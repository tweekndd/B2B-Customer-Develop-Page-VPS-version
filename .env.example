# =============================================================================
# B2B Customer Develop Platform — 环境变量配置
# 复制此文件为 .env，然后逐项填写
#   cp .env.example .env
# =============================================================================

# ─── 必填 ─────────────────────────────────────────────────────────────

# SearXNG 秘钥（任意随机字符串，用于内部签名）
SEARXNG_SECRET_KEY=请改为随机字符串，例如 openssl rand -hex 32

# Session 签名秘钥（用于用户登录会话加密）
SESSION_SECRET=请改为另一随机字符串

# ─── AI 分析 ─────────────────────────────────────────────────────────

# 智谱 GLM API（免费 | 用于 AI 客户分析）
# 申请地址: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here

# ─── 搜索引擎（二选一或全配） ────────────────────────────────────────

# SearXNG 已由 docker-compose 自动配置，默认 http://searxng:8080
# 如需外部 SearXNG 实例，取消注释并修改 URL：
# SEARXNG_URL=http://your-searxng-host:8888

# Tavily API Key（可选，付费）
# TAVILY_API_KEY=your_tavily_key_here

# SerpAPI API Key（可选，付费）
# SERPAPI_API_KEY=your_serpapi_key_here

# 强制指定搜索引擎（可选：searxng / tavily / serpapi）
# 不设置则按优先级自动检测：SearXNG > Tavily > SerpAPI
# SEARCH_ENGINE=searxng

# ─── 邮箱查找（可选） ────────────────────────────────────────────────

# Hunter API（可选）
# HUNTER_API_KEY=your_hunter_api_key_here

# Tomba API（可选）
# TOMBA_API_KEY=your_tomba_api_key_here
# TOMBA_API_SECRET=your_tomba_api_secret_here

# Prospeo API（可选）
# PROSPEO_API_KEY=your_prospeo_api_key_here

# ─── 自有邮箱发信检测 Gmail（可选，V5.2） ────────────────────────────────
# Google Cloud OAuth 2.0 Client（Web 应用），回调地址:
#   http(s)://你的域名/api/mail-accounts/oauth/callback/gmail
# GMAIL_CLIENT_ID=xxxx.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=GOCSPX-xxxx
# 可选：Gmail Pub/Sub 推送（watch 到期续期 + 实时通知），需创建 Pub/Sub topic：
# GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-sent
# 可选：Pub/Sub push 验证令牌（订阅端点需配置 Authorization header）
# GMAIL_PUBSUB_TOKEN=your-secret-token

# ─── 管理员账号（首次启动自动创建） ──────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改为强密码

# ─── 数据库（生产推荐 PostgreSQL） ─────────────────────────────────

# 留空 = 使用 SQLite（开发/单机，文件存储在 Docker 卷中）
# 生产推荐：启用 PostgreSQL 作为唯一业务中心数据库
#   1) docker-compose 启用 with-db profile（见下方 COMPOSE_PROFILES）
#   2) 设置下方 DATABASE_URL
#   3) 首次/升级 schema 执行版本化迁移：docker compose run --rm app alembic upgrade head
#      （存量 create_all 建库先 alembic stamp head，勿直接 upgrade）
#   4) 生产建议设置 DB_AUTO_CREATE=0（schema 完全交给 Alembic）
# DATABASE_URL=postgresql://b2b:密码@db:5432/b2b_customers
DB_USER=b2b
DB_PASSWORD=请改为数据库密码
DB_NAME=b2b_customers

# PostgreSQL 连接池（Phase0）
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30

# 生产 schema 管理：1=启动时自动建表/改表（SQLite 兼容），0=交给 Alembic（DB_AUTO_CREATE）
# DB_AUTO_CREATE=0

# docker compose 启用 PostgreSQL profile（与 DATABASE_URL 同时使用）
# COMPOSE_PROFILES=with-db

# ─── 数据目录与对象存储（Phase0，数据分层 L3） ──────────────────────
# 大体积原文/附件外置到本地对象存储，默认 <项目根>/data/objects
# DATA_DIR=./data

# ─── 慢查询日志（Phase0） ──────────────────────────────────────────
# 单条 SQL 超过该毫秒数时记录到 logs/slow_query.log（0=关闭，默认关闭）
# SLOW_QUERY_MS=500

# ─── 可选调优 ───────────────────────────────────────────────────────

# 缓存有效期（秒），默认 7 天
# HUNTER_CACHE_TTL=604800
# TOMBA_CACHE_TTL=604800
# PROSPEO_CACHE_TTL=604800

# 请求间隔（秒），避免触发限流
# HUNTER_REQUEST_DELAY=0.3
# TOMBA_REQUEST_DELAY=0.3
# PROSPEO_REQUEST_DELAY=0.5

# ─── 安全配置（可选） ───────────────────────────────────────────────

# API 配置加密密钥（用于加密存储用户 API Key）
# 首次部署时如未设置，系统会自动生成并持久化到 app/.config_encryption_key
# 建议在生产环境中显式设置：
# API_CONFIG_ENCRYPTION_KEY=openssl rand -hex 32 生成的随机字符串

# 受信任的反向代理 IP 列表（逗号分隔，用于 X-Forwarded-For 安全解析）
# 仅在 Nginx 与应用在同一主机时需要设置
# TRUSTED_PROXIES=127.0.0.1,172.17.0.1
