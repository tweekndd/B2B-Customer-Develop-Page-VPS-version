                "AGV warehouse",
                "autonomous mobile robot logistics",
                "automated warehouse"
            ]
        },
        "Manufacturing / Factory Automation": {
            "keywords": [
                "manufacturing automation",
                "factory automation",
                "smart factory",
                "robotics manufacturing",
