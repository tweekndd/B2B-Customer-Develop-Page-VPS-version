{
    "version": "1.0",
    "industry": "robotics",
    "description": "Robotics / Automation / AMR / AGV 行业 Google 搜索关键词体系：Country × Customer Type × Application 组合生成多个 Query",

    "countries": {
        "Singapore": ["Singapore"],
        "Thailand": ["Thailand", "Bangkok", "Chonburi", "Rayong"],
        "Malaysia": ["Malaysia", "Kuala Lumpur", "Penang", "Johor"]
    },

