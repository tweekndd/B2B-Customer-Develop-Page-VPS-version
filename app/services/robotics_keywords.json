    "default_customer_types": [
        "Robotics System Integrator",
        "Automation System Integrator",
        "AMR / AGV Integrator",
        "Robotics Distributor / Reseller",
        "Robotics Startup / AI Robotics",
        "Warehouse / Logistics Robotics",
        "Inspection / Outdoor Robotics"
    ],

    "query_templates": [
        "{phrase} {location}",
        "\"{phrase}\" {location}",
        "\"{phrase}\" {location} company"
    ],

    "competitor_exclusions": [
        "kuka", "fanuc", "abb", "yaskawa", "universal robots", "mir",
        "geek+", "hai robotics", "hikrobot", "otto motors"
