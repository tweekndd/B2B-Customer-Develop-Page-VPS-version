                "robotics lab",
                "robotics research",
                "robotics research institute",
                "AI robotics lab",
                "robot manipulation lab",
                "embodied AI lab",
                "mobile robotics lab"
            ],
            "site_queries": {
                "Singapore": ["site:.edu.sg \"robotics lab\""],
                "Thailand": ["site:.ac.th \"robotics laboratory\""],
                "Malaysia": ["site:.edu.my \"robotics lab\""]
            }
        }
